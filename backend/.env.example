# ==============================================================================
# DisasterHub India — Environment Configuration Template
# Copy this file to .env and configure values as needed for deployment.
# ==============================================================================

# Database Connection (SQLite local file or PostgreSQL for production)
DATABASE_URL=sqlite:///./disaster.db

# JWT Authentication Configuration
JWT_SECRET_KEY=disasterhub_super_secret_jwt_key_2026_india_secure_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth2 Credentials (Optional in development - fallback dev login active)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
FRONTEND_URL=http://127.0.0.1:5500

# Admin Bootstrap (Comma-separated emails automatically granted ADMIN privileges)
ADMIN_EMAILS=admin@disasterhub.gov.in,devadmin@gmail.com,admin@gmail.com

# IMD External Data Ingestion Polling Interval in seconds (default: 600s / 10 minutes)
IMD_POLL_INTERVAL_SECONDS=600
